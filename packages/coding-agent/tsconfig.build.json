{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@earendil-works/chord": ["../chord/dist/index.d.ts"],
			"@earendil-works/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@earendil-works/chord/node": ["../chord/dist/node.d.ts"],
			"@earendil-works/pi-agent-core": ["../agent/dist/index.d.ts"],
			"@earendil-works/pi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@earendil-works/pi-codemode": ["../codemode/dist/index.d.ts"],
			"@earendil-works/pi-codemode/declarations": ["../codemode/dist/declarations.d.ts"],
			"@earendil-works/pi-codemode/source": ["../codemode/dist/source.d.ts"],
			"@earendil-works/pi-codemode/worker": ["../codemode/dist/worker.d.ts"],
			"@earendil-works/pi-codemode/*": ["../codemode/dist/*.d.ts"],
			"@earendil-works/pi-ai": ["../ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@earendil-works/pi-tui": ["../tui/dist/index.d.ts"],
			"@earendil-works/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/client", "src/experimental", "src/cli/experimental"]
}
